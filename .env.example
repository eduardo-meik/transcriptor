SUMMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_ALLOW_CPU_FALLBACK=true
MEIK_LANGUAGE=es
MEIK_SAMPLE_RATE=16000
MEIK_CHANNELS=1
MEIK_OUTPUT_ROOT=outputs

# Optional: use a Hugging Face token for higher rate limits while downloading models.
# HF_TOKEN=

# Optional: disable Windows symlink cache warning from huggingface_hub.
HF_HUB_DISABLE_SYMLINKS_WARNING=1